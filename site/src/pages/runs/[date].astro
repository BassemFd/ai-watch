---
import Layout from "../../layouts/Layout.astro";
import { runs, frDate, usd, STATUS, COUNT_LABELS } from "../../lib/data.ts";
export const getStaticPaths = () => runs.map((run) => ({ params: { date: run.date }, props: { run } }));
const { run } = Astro.props;
---
<Layout title={`Run du ${run.date}`}>
  <p class="mono dim"><a href="/pipeline/">← pipeline</a></p>
  <h1>Run du {frDate(run.date)}</h1>
  <div class="panel stats">
    <div><b class={run.status}>{STATUS[run.status]}</b><span>statut</span></div>
    {Object.entries(run.counts).map(([k, v]) => <div><b>{v}</b><span>{COUNT_LABELS[k] ?? k}</span></div>)}
    <div><b>{Math.round(run.durationMs / 1000)} s</b><span>durée</span></div>
    <div><b>{usd(run.costUsd)}</b><span>coût</span></div>
  </div>
  {run.error && <p class="panel error mono">{run.error}</p>}

  <h2>Portes</h2>
  {run.gates.length === 0 && <p class="dim">Le run s'est arrêté avant les portes.</p>}
  {run.gates.map((g) => (
    <p><span class={`tag ${g.pass ? "published" : "rejected"}`}>{g.pass ? "passe" : "échec"}</span> <b>{g.name}</b> <span class="dim">— {g.detail}</span></p>
  ))}

  <h2>Appels aux modèles</h2>
  <div class="scroll">
    <table>
      <thead><tr><th>étape</th><th>modèle</th><th>entrée</th><th>sortie</th><th>durée</th><th>coût</th></tr></thead>
      <tbody>
        {run.stages.map((s) => (
          <tr><td>{s.stage}</td><td>{s.model}</td><td>{s.inputTokens}</td><td>{s.outputTokens}</td><td>{(s.ms / 1000).toFixed(1)} s</td><td>{usd(s.costUsd)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Rejets ({run.rejected.length})</h2>
  <div class="scroll">
    <table>
      <tbody>
        {run.rejected.map((x) => <tr><td class="wrap">{x.what}</td><td class="wrap rejected">{x.reason}</td></tr>)}
      </tbody>
    </table>
  </div>
</Layout>
