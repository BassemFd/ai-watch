---
import Layout from "../../layouts/Layout.astro";
import Evidence from "../../components/Evidence.astro";
import { radar } from "../../lib/data.ts";
import { day, langOf, langPaths, ui } from "../../lib/i18n.ts";
import { RINGS } from "../../../../pipeline/schema.ts";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
---
<Layout title={t.radar.title} lang={lang} path="/radar/">
  <h1>{t.radar.h1}</h1>
  <p class="lede">{t.radar.lede}</p>

  <ol class="scale" aria-hidden="true">
    {RINGS.map((ring) => (
      <li class={radar.entries.some((e) => e.ring === ring) ? "on" : ""}>
        <b>{t.rings[ring]}</b>
        <span>{radar.entries.filter((e) => e.ring === ring).length}</span>
      </li>
    ))}
  </ol>

  {RINGS.map((ring) => {
    const entries = radar.entries.filter((e) => e.ring === ring);
    return (
      <section>
        <h2>{t.rings[ring]}</h2>
        <p class="muted">{t.ringHints[ring]}</p>
        {entries.length === 0 && <p class="muted">{t.radar.empty}</p>}
        {entries.map((e) => (
          <div class="pair">
            <div>
              <h3>{e.name}</h3>
              <p>{e.rationale[lang]}</p>
              <p class="small muted">
                {t.radar.since(day(lang, e.since))}
                {e.history.length > 1 && `, ${t.radar.path} : ${e.history.map((h) => t.rings[h.ring]).join(" → ")}`}
              </p>
            </div>
            <Evidence claims={e.evidence} lang={lang} collapsed />
          </div>
        ))}
      </section>
    );
  })}
</Layout>

<style>
  /* L'échelle : du plus sûr au plus prudent, avec le nombre d'entrées par anneau. */
  .scale { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .scale li { padding: 1rem 1.15rem; display: flex; flex-direction: column; color: var(--muted); border: 1px solid var(--line); border-radius: 14px; }
  .scale b { font-weight: 600; font-size: clamp(0.8rem, 2vw, 1rem); }
  .scale span { font-size: clamp(1.6rem, 5vw, 2.5rem); font-weight: 700; line-height: 1; margin-top: 0.5rem; }
  .scale .on { color: var(--ink); box-shadow: var(--lift); }
  .scale .on span { background: var(--marker); color: var(--marker-ink); align-self: start; padding: 0 0.15em; border-radius: 3px; }
</style>
