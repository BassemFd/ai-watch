---
import Layout from "../../../layouts/Layout.astro";
import { runs, usd } from "../../../lib/data.ts";
import { day, href, langOf, langPaths, ui } from "../../../lib/i18n.ts";
export const getStaticPaths = () =>
  langPaths().flatMap(({ params }) => runs.map((run) => ({ params: { ...params, date: run.date }, props: { run } })));
const { run } = Astro.props;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
---
<Layout title={t.run.title(run.date)} lang={lang} path={`/runs/${run.date}/`}>
  <p><a href={href(lang, "/pipeline/")}>{t.run.back}</a></p>
  <h1>{t.run.title(day(lang, run.date))}</h1>
  <p class="lede">
    <span class={`stamp ${run.status}`}>{t.status[run.status]}</span>
    {" "}{Math.round(run.durationMs / 1000)} s, {usd(run.costUsd)}.
  </p>
  {run.error && <p class="error">{run.error}</p>}

  <dl class="counts">
    {Object.entries(run.counts).map(([k, v]) => <div><dd>{v}</dd><dt>{t.counts[k] ?? k}</dt></div>)}
  </dl>

  <h2>{t.run.gates}</h2>
  {run.gates.length === 0 && <p class="muted">{t.run.noGates}</p>}
  <ul class="gates">
    {run.gates.map((g) => (
      <li>
        <span class={`stamp ${g.pass ? "" : "rejected"}`}>{g.pass ? t.run.pass : t.run.fail}</span>
        <b>{t.gates[g.name] ?? g.name}</b>
        <span class="muted">{g.detail}</span>
      </li>
    ))}
  </ul>

  <h2>{t.run.tools(run.toolCalls.length)}</h2>
  {run.toolCalls.length === 0 ? <p class="muted">{t.run.noTools}</p> : (
    <div class="scroll">
      <table>
        <thead><tr><th>{t.run.toolCols[1]}</th><th>{t.run.toolCols[2]}</th><th>{t.run.toolCols[3]}</th><th class="num">{t.run.toolCols[4]}</th></tr></thead>
        <tbody>
          {run.toolCalls.map((c) => (
            <tr>
              <td>{c.tool}</td>
              <td class="url">{c.input}</td>
              <td>{c.ok ? t.run.allowed : <span class="rejected">{t.run.refused}{c.detail && ` (${c.detail})`}</span>}</td>
              <td class="num">{c.ms} ms</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>{t.run.calls}</h2>
  <div class="scroll">
    <table>
      <thead><tr>{t.run.cols.map((c, i) => <th class={i > 1 ? "num" : ""}>{c}</th>)}</tr></thead>
      <tbody>
        {run.stages.map((s) => (
          <tr><td>{s.stage}</td><td>{s.model.replace("claude-", "")}</td><td class="num">{s.inputTokens}</td><td class="num">{s.outputTokens}</td><td class="num">{(s.ms / 1000).toFixed(1)} s</td><td class="num">{usd(s.costUsd)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>{t.run.rejects(run.rejected.length)}</h2>
  <ul class="refused">
    {run.rejected.map((x) => (
      <li>
        <s>{x.what[lang]}</s>
        <span class="rejected">{t.reasons[x.reason] ?? x.reason}{x.detail && ` (${x.detail})`}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; margin: 2.5rem 0 0; }
  .counts div { display: flex; flex-direction: column; padding: 1.1rem 1.25rem; background: var(--sheet); border-radius: 14px; }
  .counts dd { margin: 0; font-size: 2.25rem; line-height: 1; font-weight: 700; letter-spacing: -0.02em; }
  .counts dt { color: var(--muted); font-size: 0.9rem; margin-top: 0.3rem; }
  .gates { list-style: none; padding: 0; margin: 0; }
  .gates li { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; align-items: baseline; padding-block: 0.7rem; border-top: 1px solid var(--line-soft); }
  .refused { list-style: none; padding: 0; margin: 0; }
  .refused li { display: grid; gap: 0.3rem 3rem; padding-block: 1rem; border-top: 1px solid var(--line-soft); }
  @media (min-width: 58rem) { .refused li { grid-template-columns: minmax(0, 38rem) minmax(0, 1fr); } }
  .refused span { font-size: 0.92rem; }
</style>
