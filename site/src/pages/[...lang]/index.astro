---
import Layout from "../../layouts/Layout.astro";
import Evidence from "../../components/Evidence.astro";
import { briefs, runs } from "../../lib/data.ts";
import { day, href, langOf, langPaths, ui } from "../../lib/i18n.ts";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
const [last] = runs;
const [today, ...earlier] = briefs;
// La pièce à conviction de la page : une vraie phrase du jour et sa citation.
const specimen = today?.items[0]?.claims[0];
---
<Layout lang={lang} path="/">
  <div class="hero">
    <div>
      <h1>{t.home.h1}</h1>
      <p class="lede">{t.home.lede}</p>
    </div>
    {specimen && (
      <figure class="specimen">
        <p class="claim">{specimen.text[lang]}</p>
        <blockquote><mark>{specimen.quote}</mark></blockquote>
        <figcaption>{t.home.proofCaption} <a href={specimen.url} rel="noopener">{new URL(specimen.url).hostname}</a></figcaption>
      </figure>
    )}
  </div>

  {last ? (
    <p class="runline">
      <span class={`stamp ${last.status}`}>{t.status[last.status]}</span>
      {t.home.runLine(day(lang, last.date), last.counts, last.rejected.length)}{" "}
      <a href={href(lang, `/runs/${last.date}/`)}>{t.home.runLink}</a>
    </p>
  ) : (
    <p class="runline muted">{t.home.noRun}</p>
  )}

  {today && (
    <section>
      <h2>{today.headline[lang]}</h2>
      <p class="muted">{t.home.editionOf(day(lang, today.date))}</p>
      {today.items.map((item) => (
        <article class="pair">
          <div>
            <h3><a href={item.url} rel="noopener">{item.title[lang]}</a></h3>
            <p>{item.summary[lang]}</p>
            <p class="muted">{item.why[lang]}</p>
            <p class="small muted">{item.source}</p>
          </div>
          <Evidence claims={item.claims} lang={lang} />
        </article>
      ))}
    </section>
  )}

  {earlier.length > 0 && (
    <section>
      <h2>{t.home.earlier}</h2>
      {earlier.slice(0, 14).map((b) => (
        <details class="earlier">
          <summary><span class="muted">{day(lang, b.date)}</span> {b.headline[lang]}</summary>
          {b.items.map((item) => (
            <p><a href={item.url} rel="noopener">{item.title[lang]}</a>. {item.summary[lang]}</p>
          ))}
        </details>
      ))}
    </section>
  )}
</Layout>

<style>
  /* L'accroche à gauche, la pièce à conviction à droite : une phrase du jour et sa preuve. */
  .hero { display: grid; gap: 1.75rem 3.5rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 58rem) { .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .specimen { margin: 0; padding: 1.4rem 1.5rem; background: var(--sheet); border: 1px solid var(--line); border-radius: 6px; display: grid; gap: 1rem; }
  .specimen .claim { font-size: clamp(1.1rem, 1.7vw, 1.3rem); line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; margin: 0; max-width: none; }
  .specimen blockquote { margin: 0; font: 400 0.98rem/1.8 var(--typed); }
  .specimen figcaption { color: var(--muted); font-size: 0.88rem; }
  .runline { margin: 2.25rem 0 0; padding-top: 1rem; border-top: 2px solid var(--ink); max-width: none; }
  .runline .stamp { margin-right: 0.6rem; }
  .earlier { border-top: 1px solid var(--line); padding-block: 0.9rem; }
  .earlier summary { cursor: pointer; font-weight: 600; }
  .earlier p { margin-top: 0.8rem; }
</style>
