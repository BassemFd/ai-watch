---
import Layout from "../../layouts/Layout.astro";
import Evidence from "../../components/Evidence.astro";
import { briefs, runs } from "../../lib/data.ts";
import { day, href, langOf, langPaths, ui } from "../../lib/i18n.ts";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
const [last] = runs;
const [today, ...earlier] = briefs;
// La pièce à conviction de la page : une vraie phrase du jour et sa citation.
const specimen = today?.items[0]?.claims[0];
---
<Layout lang={lang} path="/">
  <div class="hero">
    <div>
      <h1>{t.home.h1}</h1>
      <p class="lede">{t.home.lede}</p>
    </div>
    {specimen && (
      <figure class="specimen">
        <p class="claim">{specimen.text[lang]}</p>
        <blockquote><mark>{specimen.quote}</mark></blockquote>
        <figcaption>{t.home.proofCaption} <a href={specimen.url} rel="noopener">{new URL(specimen.url).hostname}</a></figcaption>
      </figure>
    )}
  </div>

  {last ? (
    <p class="runline">
      <span class={`stamp ${last.status}`}>{t.status[last.status]}</span>
      {t.home.runLine(day(lang, last.date), last.counts, last.rejected.length)}{" "}
      <a href={href(lang, `/runs/${last.date}/`)}>{t.home.runLink}</a>
    </p>
  ) : (
    <p class="runline muted">{t.home.noRun}</p>
  )}

  {today && (
    <section>
      <h2>{t.home.editionOf(day(lang, today.date))}</h2>
      {today.items.map((item, i) => (
        <details class="item" open={i === 0}>
          <summary>
            <h3>{item.title[lang]}</h3>
            <span class="teaser">{item.summary[lang]}</span>
            <span class="meta"><span>{item.source}{item.confirmedBy && ` + ${item.confirmedBy.source}`}</span>{!item.confirmedBy && <span class="single">{t.home.singleSource}</span>}<span class="count">{t.evidence(item.claims.length)}</span></span>
          </summary>
          <div class="pair">
            <div>
              <p>{item.summary[lang]}</p>
              <p class="muted">{item.why[lang]}</p>
              <p class="small"><a class="btn" href={item.url} rel="noopener">{t.home.readSource}</a>{item.confirmedBy && <> · {t.home.confirmedBy} <a href={item.confirmedBy.url} rel="noopener">{item.confirmedBy.source}</a></>}</p>
            </div>
            <Evidence claims={item.claims} lang={lang} />
          </div>
        </details>
      ))}
    </section>
  )}

  {earlier.length > 0 && (
    <section>
      <h2>{t.home.earlier}</h2>
      {earlier.slice(0, 14).map((b) => (
        <details class="earlier">
          <summary>{day(lang, b.date)} <span class="muted">{t.home.itemsCount(b.items.length)}</span></summary>
          {b.items.map((item) => (
            <p><a href={item.url} rel="noopener">{item.title[lang]}</a>. {item.summary[lang]}</p>
          ))}
        </details>
      ))}
    </section>
  )}
</Layout>

<style>
  /* L'accroche à gauche, la pièce à conviction à droite : une phrase du jour et sa preuve. */
  .hero { display: grid; gap: 2rem 4rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 58rem) { .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .specimen { margin: 0; padding: 1.5rem; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--lift); display: grid; gap: 1rem; }
  .specimen .claim { font-size: 1.25rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; margin: 0; max-width: none; color: var(--ink); }
  .specimen blockquote { margin: 0; font: 400 0.9rem/1.7 var(--typed); }
  .specimen figcaption { color: var(--muted); font-size: 0.8125rem; }
  .runline { margin: 2.5rem 0 0; padding: 1rem 1.25rem; background: var(--sheet); border-radius: 14px; max-width: none; color: var(--body); font-size: 0.9375rem; }
  .runline .stamp { margin-right: 0.6rem; }
  /* Une brève = une carte : titre, une ligne de résumé, la source et le nombre de preuves ; elle s'ouvre sur ses preuves. */
  .item { border: 1px solid var(--line); border-radius: 14px; margin-bottom: 1rem; padding-inline: 1.5rem; background: var(--paper); }
  .item:hover { box-shadow: var(--lift); }
  .item summary { list-style: none; cursor: pointer; display: grid; gap: 0.35rem; padding: 1.25rem 2.25rem 1.25rem 0; position: relative; }
  .item summary::-webkit-details-marker { display: none; }
  .item summary::after { content: ""; position: absolute; right: 0.4rem; top: 1.6rem; width: 0.55rem; height: 0.55rem; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: rotate(45deg); transition: transform 0.2s; }
  .item[open] summary::after { transform: rotate(-135deg); top: 1.8rem; }
  .item h3 { margin: 0; }
  .teaser { color: var(--muted); overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .item[open] .teaser { display: none; }
  .single { border: 1px solid var(--line); border-radius: 9999px; padding: 0.1em 0.7em; font-size: 0.8125rem; font-weight: 500; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; align-items: center; font-size: 0.875rem; color: var(--muted); }
  .item > .pair { padding-top: 1.25rem; padding-bottom: 1.5rem; }
  @media (prefers-reduced-motion: reduce) { .item summary::after { transition: none; } }
  .earlier { border-top: 1px solid var(--line-soft); padding-block: 1rem; }
  .earlier summary { cursor: pointer; font-weight: 600; }
  .earlier p { margin-top: 0.8rem; }
</style>
