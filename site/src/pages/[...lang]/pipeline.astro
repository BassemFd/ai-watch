---
import Layout from "../../layouts/Layout.astro";
import { runs, evals, usd } from "../../lib/data.ts";
import { day, href, langOf, langPaths, ui } from "../../lib/i18n.ts";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
const [last] = runs;
// Ce que chaque étape laisse passer lors du dernier run, dans l'ordre des étapes du dictionnaire.
const OUT = ["nouveaux", "retenus", "faitsProposes", "faitsCites", "faitsValides", null, "publies", null, null];
const CUT: Record<number, [string, string]> = { 3: ["faitsProposes", "faitsCites"], 4: ["faitsCites", "faitsValides"] };
const figure = (i: number) => (last && OUT[i] != null ? last.counts[OUT[i]!] : undefined);
const cut = (i: number) => (last && CUT[i] ? (last.counts[CUT[i][0]] ?? 0) - (last.counts[CUT[i][1]] ?? 0) : 0);
const recent = runs.slice(0, 30);
const rejections = runs.slice(0, 7).flatMap((r) => r.rejected.map((x) => ({ ...x, date: r.date }))).slice(0, 25);
---
<Layout title={t.pipeline.title} lang={lang} path="/pipeline/">
  <h1>{t.pipeline.h1}</h1>
  <p class="lede">{t.pipeline.lede}</p>

  {last && <p class="muted figures">{t.pipeline.figuresOf(day(lang, last.date))}</p>}
  <ol class="ledger">
    {t.pipeline.stages.map(([name, who, what], i) => (
      <li style={`--i:${i}`} class={who === "code" ? "code" : "model"}>
        <div class="who">{who}</div>
        <div class="what"><b>{name}</b><p>{what}</p></div>
        <div class="out">
          {figure(i) !== undefined && <><strong>{figure(i)}</strong><span>{t.counts[OUT[i]!]}</span></>}
          {cut(i) > 0 && <s class="rejected">{t.pipeline.cut(cut(i))}</s>}
        </div>
      </li>
    ))}
  </ol>

  <h2>{t.pipeline.limitsTitle}</h2>
  <p>{t.pipeline.limits}</p>

  {evals && (
    <>
      <h2>{t.pipeline.evalTitle}</h2>
      <p>
        <span class={`stamp ${evals.failures.length ? "rejected" : ""}`}>{evals.passed}/{evals.total}</span>
        {" "}{t.pipeline.evalCases}, {t.pipeline.evalLast} {day(lang, evals.date)}.
        {evals.failures.length > 0 && ` ${t.pipeline.evalFailing} : ${evals.failures.join(", ")}.`}
      </p>
    </>
  )}

  <h2>{t.pipeline.runsTitle(recent.length)}</h2>
  {recent.length === 0 ? <p class="muted">{t.home.noRun}</p> : (
    <div class="scroll">
      <table>
        <thead><tr>{t.pipeline.cols.map((c, i) => <th class={i > 1 ? "num" : ""}>{c}</th>)}</tr></thead>
        <tbody>
          {recent.map((r) => (
            <tr>
              <td><a href={href(lang, `/runs/${r.date}/`)}>{day(lang, r.date)}</a></td>
              <td><span class={`stamp ${r.status}`}>{t.status[r.status]}</span></td>
              <td class="num">{r.counts.nouveaux ?? 0}</td>
              <td class="num">{r.counts.faitsCites ?? 0}/{r.counts.faitsProposes ?? 0}</td>
              <td class="num">{r.rejected.length}</td>
              <td class="num">{Math.round(r.durationMs / 1000)} s</td>
              <td class="num">{usd(r.costUsd)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {rejections.length > 0 && (
    <>
      <h2>{t.pipeline.refusedTitle}</h2>
      <ul class="refused">
        {rejections.map((x) => (
          <li>
            <s>{x.what[lang]}</s>
            <span class="rejected">{t.reasons[x.reason] ?? x.reason}{x.detail && ` (${x.detail})`}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</Layout>

<style>
  .figures { margin: 3rem 0 0.5rem; }
  .ledger { list-style: none; margin: 0; padding: 0; counter-reset: stage; border-top: 2px solid var(--ink); }
  .ledger li { counter-increment: stage; display: grid; gap: 0.25rem 2rem; grid-template-columns: minmax(0, 1fr); padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 52rem) { .ledger li { grid-template-columns: 9rem minmax(0, 1fr) 13rem; align-items: start; } }
  .who { color: var(--muted); }
  .who::before { content: counter(stage) ". "; }
  .model .who { color: var(--ink); font-weight: 600; }
  .what b { font-size: 1.25rem; font-weight: 650; letter-spacing: -0.01em; }
  .what p { margin: 0.2rem 0 0; color: var(--muted); max-width: 52ch; }
  .out { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem; }
  .out strong { font-size: 2.4rem; line-height: 1; font-weight: 750; letter-spacing: -0.03em; }
  .out span { color: var(--muted); font-size: 0.9rem; }
  .out s { flex-basis: 100%; font-size: 0.9rem; }
  /* Le seul mouvement de la page : les étapes s'inscrivent dans l'ordre où le run les traverse. */
  @media (prefers-reduced-motion: no-preference) {
    .ledger li { animation: inscribe 0.45s both; animation-delay: calc(var(--i) * 110ms); }
    @keyframes inscribe { from { opacity: 0; transform: translateY(0.5rem); } }
  }
  .refused { list-style: none; padding: 0; margin: 0; }
  .refused li { display: grid; gap: 0.3rem 3rem; padding-block: 1rem; border-top: 1px solid var(--line); }
  @media (min-width: 58rem) { .refused li { grid-template-columns: minmax(0, 38rem) minmax(0, 1fr); } }
  .refused span { font-size: 0.92rem; }
</style>
