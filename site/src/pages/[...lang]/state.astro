---
import Layout from "../../layouts/Layout.astro";
import Evidence from "../../components/Evidence.astro";
import { state } from "../../lib/data.ts";
import { day, langOf, langPaths, ui } from "../../lib/i18n.ts";
import { SECTIONS } from "../../../../pipeline/schema.ts";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = ui[lang];
const bySection = SECTIONS.map((s) => ({ id: s.id, points: state.points.filter((p) => p.sectionId === s.id).reverse() }));
---
<Layout title={t.state.title} lang={lang} path="/state/">
  <h1>{t.state.h1}</h1>
  <p class="lede">{t.state.lede}</p>
  {bySection.map((s) => (
    <section>
      <h2>{t.sections[s.id]}</h2>
      {s.points.length === 0 && <p class="muted">{t.state.empty}</p>}
      {s.points.map((p) => (
        <div class="pair">
          <div>
            <p class="point">{p.text[lang]}</p>
            <p class="small muted">{t.state.added(day(lang, p.date))}</p>
          </div>
          <Evidence claims={p.evidence} lang={lang} collapsed />
        </div>
      ))}
    </section>
  ))}
</Layout>

<style>
  .point { font-size: 1.2rem; line-height: 1.4; font-weight: 500; }
</style>
