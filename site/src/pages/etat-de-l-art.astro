---
import Layout from "../layouts/Layout.astro";
import Evidence from "../components/Evidence.astro";
import { state, frDate } from "../lib/data.ts";
import { SECTIONS } from "../../../pipeline/schema.ts";
const bySection = SECTIONS.map((s) => ({ ...s, points: state.points.filter((p) => p.sectionId === s.id).reverse() }));
---
<Layout title="État de l'art">
  <h1>Où en est l'IA.</h1>
  <p class="lede">
    Ce document se construit seul : chaque run peut y ajouter au plus trois points, jamais en réécrire. Un point n'entre
    que s'il repose sur des faits vérifiés, et il garde ses preuves.
  </p>
  {bySection.map((s) => (
    <section>
      <h2>{s.title}</h2>
      {s.points.length === 0 && <p class="dim">Rien d'établi par le pipeline pour l'instant.</p>}
      {s.points.map((p) => (
        <div class="panel">
          <p>{p.text}</p>
          <span class="mono dim">ajouté le {frDate(p.date)}</span>
          <Evidence claims={p.evidence} />
        </div>
      ))}
    </section>
  ))}
</Layout>
