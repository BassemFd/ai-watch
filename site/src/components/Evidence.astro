---
import { ui } from "../lib/i18n.ts";
const { claims, lang } = Astro.props;
---
<details class="evidence">
  <summary>{ui[lang].evidence(claims.length)}</summary>
  <ul>
    {claims.map((c) => (
      <li>
        <p>{c.text[lang]}</p>
        <blockquote>{c.quote}</blockquote>
        <a href={c.url} rel="noopener">{new URL(c.url).hostname}</a>
      </li>
    ))}
  </ul>
</details>
