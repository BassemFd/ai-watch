---
import { href, ui, type Lang } from "../lib/i18n.ts";
// `path` est le chemin sans préfixe de langue, par exemple "/radar/".
const { title, lang, path } = Astro.props as { title?: string; lang: Lang; path: string };
const t = ui[lang];
const other: Lang = lang === "fr" ? "en" : "fr";
const nav = [
  ["/", t.nav.today],
  ["/state/", t.nav.state],
  ["/radar/", t.nav.radar],
  ["/pipeline/", t.nav.pipeline],
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${t.siteTitle.split(" — ")[0]}` : t.siteTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Avant le premier rendu, pour éviter un éclair de l'autre thème.
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <link rel="alternate" hreflang={other} href={href(other, path)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" />
  </head>
  <body>
    <header>
      <a class="brand" href={href(lang, "/")}>{t.brand[0]}<span>/</span>{t.brand[1]}</a>
      <nav>
        {nav.map(([p, label]) => <a href={href(lang, p)} aria-current={p === path ? "page" : undefined}>{label}</a>)}
      </nav>
      <div class="tools">
        <a class="lang" href={href(other, path)} lang={other} hreflang={other}>{t.switchTo}</a>
        <button class="theme" type="button" data-dark={t.theme.dark} data-light={t.theme.light}>{t.theme.dark}</button>
      </div>
    </header>
    <main><slot /></main>
    <script is:inline>
      (() => {
        const root = document.documentElement, button = document.querySelector(".theme");
        const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
        const label = () => { button.textContent = isDark() ? button.dataset.light : button.dataset.dark; };
        button.addEventListener("click", () => {
          root.dataset.theme = isDark() ? "light" : "dark";
          try { localStorage.setItem("theme", root.dataset.theme); } catch {}
          label();
        });
        label();
      })();
    </script>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="about">
          <a class="brand" href={href(lang, "/")}>{t.brand[0]}<span>/</span>{t.brand[1]}</a>
          <p>{t.footer}</p>
          <a href={href(lang, "/pipeline/")}>{t.footerLink}</a>
        </div>
        <div class="author">
          <p>{t.signature.by} <a href="https://bassemfayed.com/" rel="noopener">Bassem Fayed</a> {t.signature.love} <span aria-hidden="true">♥</span><span class="sr-only">{t.signature.loveWord}</span></p>
          <ul class="social">
            <li><a href="https://github.com/BassemFd" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.51 11.51 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg></a></li>
            <li><a href="https://www.linkedin.com/in/bassem-fd/" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" /></svg></a></li>
            <li><a href="mailto:bassem.fayed@gmail.com" aria-label={t.signature.mail}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3 6.5 9 7 9-7" /></svg></a></li>
          </ul>
        </div>
        <div class="elsewhere">
          <p>{t.signature.also}</p>
          <ul>
            <li><a href="https://bassemfayed.com/" rel="noopener">Career log</a></li>
            <li><a href="https://neja.bassemfayed.com" rel="noopener">NeJa</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Place de marché claire : toile blanche, encre #222, une seule couleur de marque (le rausch) pour ce qui
     se clique ou se prouve. Formes douces : 8px pour les boutons, 14px pour les cartes, pilules pour le reste.
     Une seule ombre, au survol. Les valeurs viennent de DESIGN.md ; la teinte de surbrillance et le sombre
     en sont dérivés (le document n'a pas de mode sombre). */
  :root {
    --paper: #ffffff; --sheet: #f3f5f7; --strong: #e6eaef; --ink: #14213d; --body: #2d3b5c; --muted: #556072; --line: #d3d9e1; --line-soft: #e3e8ee;
    --marker: #ffe45c; --marker-ink: #14213d; --marker-active: #f2d330; --red: #c8102e;
    --sans: "Inter", -apple-system, system-ui, Roboto, "Helvetica Neue", sans-serif;
    --typed: "Courier Prime", "Courier New", monospace;
    --lift: rgba(0,0,0,0.02) 0 0 0 1px, rgba(0,0,0,0.04) 0 2px 6px 0, rgba(0,0,0,0.1) 0 4px 8px 0;
  }
  /* Sombre : choix explicite du lecteur, sinon réglage du système. */
  :root[data-theme="dark"] { --paper: #0e131d; --sheet: #171e2d; --strong: #232c3f; --ink: #e8ecf3; --body: #cfd6e2; --muted: #9ba6b8; --line: #2a3447; --line-soft: #222b3c; --red: #ff7582; --marker: #3fb950; --marker-ink: #0e131d; --marker-active: #55c96a; --lift: rgba(0,0,0,0.3) 0 2px 8px 0, rgba(0,0,0,0.5) 0 4px 12px 0; color-scheme: dark; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --paper: #0e131d; --sheet: #171e2d; --strong: #232c3f; --ink: #e8ecf3; --body: #cfd6e2; --muted: #9ba6b8; --line: #2a3447; --line-soft: #222b3c; --red: #ff7582; --marker: #3fb950; --marker-ink: #0e131d; --marker-active: #55c96a; --lift: rgba(0,0,0,0.3) 0 2px 8px 0, rgba(0,0,0,0.5) 0 4px 12px 0; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1rem/1.5 var(--sans); overflow-wrap: break-word; }
  header, main { max-width: 80rem; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  /* En-tête : nom, rubriques, réglages sur une ligne ; sous 60rem, les rubriques passent sur une seconde
     ligne entière, jamais coupées en deux (elles défilent si l'écran est trop étroit). */
  header { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.75rem 2.5rem; align-items: center; min-height: 5rem; padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .brand { font-weight: 700; font-size: 1.4rem; letter-spacing: -0.03em; color: var(--ink); text-decoration: none; }
  .brand span { background: var(--marker); color: var(--marker-ink); padding: 0 0.15em; }
  header nav { display: flex; gap: 1.75rem; white-space: nowrap; justify-content: center; }
  header nav a { color: var(--muted); text-decoration: none; font-weight: 600; padding-block: 0.6rem; border-bottom: 2px solid transparent; }
  header nav a:hover { color: var(--ink); }
  header nav a[aria-current] { color: var(--ink); border-bottom-color: var(--ink); }
  .tools { display: flex; align-items: center; gap: 0.6rem; }
  .lang, .theme { font: 500 0.875rem/1 var(--sans); color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 9999px; padding: 0.7rem 1rem; cursor: pointer; text-decoration: none; }
  .lang:hover, .theme:hover { border-color: var(--ink); text-decoration: none; }
  /* Petit écran : le nom et les réglages sur une ligne, les rubriques dessous. */
  @media (max-width: 60rem) {
    header { grid-template-columns: minmax(0, 1fr) auto; }
    header nav { grid-column: 1 / -1; grid-row: 2; gap: 1.4rem; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
    header nav::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 26rem) { header nav { gap: 1rem; font-size: 0.94rem; } }
  @media (max-width: 22rem) { header nav { gap: 0.8rem; font-size: 0.9rem; } }
  main { padding-block: clamp(1.5rem, 4vw, 4rem) 4rem; }
  /* Pied de page : même toile que la page, pas de contraste ; trois blocs côte à côte, empilés sur mobile. */
  .site-footer { margin-top: 4rem; background: var(--paper); border-top: 1px solid var(--line); }
  .footer-inner { max-width: 80rem; margin: 0 auto; padding: 3rem clamp(1rem, 4vw, 2.5rem) 3rem; display: grid; gap: 2rem 3rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .footer-inner { grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr) minmax(0, 1fr); } }
  .site-footer p { margin: 0 0 0.6rem; max-width: 42ch; color: var(--muted); font-size: 0.875rem; line-height: 1.43; }
  .site-footer li { font-size: 0.875rem; }
  .about .brand { display: inline-block; margin-bottom: 0.6rem; }
  .author p { color: var(--ink); }
  .social, .elsewhere ul { list-style: none; padding: 0; margin: 0; }
  .social { display: flex; gap: 0.6rem; }
  .social a { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; background: var(--strong); border-radius: 50%; color: var(--ink); }
  .social a:hover { box-shadow: var(--lift); }
  .social svg { width: 1.1rem; height: 1.1rem; }
  .elsewhere ul { display: grid; gap: 0.5rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  a { color: inherit; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }

  h1 { font-weight: 700; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 1rem; max-width: 22ch; text-wrap: balance; }
  h2 { font-weight: 600; font-size: clamp(1.25rem, 2.4vw, 1.5rem); line-height: 1.2; letter-spacing: -0.02em; margin: 4rem 0 1rem; text-wrap: balance; }
  h3 { font-weight: 600; font-size: 1.25rem; line-height: 1.25; letter-spacing: -0.01em; margin: 0 0 0.5rem; text-wrap: balance; }
  p { margin: 0 0 0.9rem; max-width: 62ch; color: var(--body); }
  .lede { font-size: 1.125rem; line-height: 1.5; max-width: 52ch; color: var(--muted); }
  .muted { color: var(--muted); }
  .small { font-size: 0.875rem; }
  /* Bouton principal : la couleur de marque (ici le surligneur), texte d'encre, 8px. Une seule par bloc. */
  .btn { display: inline-block; padding: 0.7rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; color: var(--marker-ink); background: var(--marker); }
  .btn:hover { background: var(--marker-active); text-decoration: none; }

  /* Un texte publié et, dans la marge, ce qui le prouve. */
  .pair > *, .hero > * { min-width: 0; }
  blockquote, td.url, .proof figcaption { overflow-wrap: anywhere; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem 3rem; padding-block: 1.75rem; border-top: 1px solid var(--line-soft); }
  @media (min-width: 58rem) { .pair { grid-template-columns: minmax(0, 38rem) minmax(0, 1fr); } }
  .proofs { display: grid; gap: 1rem; align-content: start; }
  .proof { margin: 0; padding: 1rem 1.15rem; background: var(--sheet); border-radius: 14px; }
  .proof blockquote { margin: 0 0 0.5rem; font: 400 0.9rem/1.7 var(--typed); color: var(--ink); }
  .proof blockquote.second { margin: 0.6rem 0 0.5rem; padding-top: 0.6rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  mark { background: var(--marker); color: var(--marker-ink); padding: 0.1em 0.2em; border-radius: 3px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .proof figcaption { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .proofs summary { cursor: pointer; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem; }
  .count { display: inline-block; background: var(--marker); color: var(--marker-ink); font-weight: 600; font-size: 0.8125rem; padding: 0.2em 0.75em; border-radius: 9999px; }
  .proofs summary:hover .count { box-shadow: 0 0 0 2px var(--marker); }
  /* Sombre : les citations s'affichent comme une sortie de terminal, en vert phosphore. */
  :root[data-theme="dark"] mark { background: rgb(63 185 80 / 0.12); color: var(--marker); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) mark { background: rgb(63 185 80 / 0.12); color: var(--marker); } }

  /* Tampons : passé, refusé. Le refusé est en rouge d'erreur, pas en rausch (la marque ne dit jamais « non »). */
  .stamp { display: inline-block; border: 1px solid currentColor; border-radius: 9999px; padding: 0.15em 0.75em; font-weight: 600; font-size: 0.8125rem; white-space: nowrap; }
  .rejected, .error { color: var(--red); }
  .empty { color: var(--muted); }
  s { text-decoration-color: var(--red); text-decoration-thickness: 2px; }

  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; vertical-align: top; padding: 0.75rem 1.25rem 0.75rem 0; border-top: 1px solid var(--line-soft); }
  th { font-weight: 500; color: var(--muted); border-top: 0; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  td.wrap { min-width: 15rem; }
  td.url { font: 0.8125rem/1.5 var(--typed); word-break: break-all; min-width: 14rem; }
</style>
