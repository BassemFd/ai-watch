---
import { href, ui, type Lang } from "../lib/i18n.ts";
// `path` est le chemin sans préfixe de langue, par exemple "/radar/".
const { title, lang, path } = Astro.props as { title?: string; lang: Lang; path: string };
const t = ui[lang];
const other: Lang = lang === "fr" ? "en" : "fr";
const nav = [
  ["/", t.nav.today],
  ["/state/", t.nav.state],
  ["/radar/", t.nav.radar],
  ["/pipeline/", t.nav.pipeline],
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${t.siteTitle.split(" — ")[0]}` : t.siteTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="alternate" hreflang={other} href={href(other, path)} />
  </head>
  <body>
    <header>
      <a class="brand" href={href(lang, "/")}>veille<span>/</span>ia</a>
      <nav>
        {nav.map(([p, label]) => <a href={href(lang, p)} aria-current={p === path ? "page" : undefined}>{label}</a>)}
        <a class="lang" href={href(other, path)} lang={other} hreflang={other}>{t.switchTo}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>{t.footer} <a href={href(lang, "/pipeline/")}>{t.footerLink}</a></footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0e0d; --panel: #141816; --line: #262c29; --text: #e9ece8; --dim: #98a39c;
    --ok: #7ee2a8; --warn: #f2c14e; --bad: #ff7a6b;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.6 Georgia, "Times New Roman", serif; }
  header, main, footer { max-width: 60rem; margin: 0 auto; padding: 0 1.25rem; }
  header { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: baseline; padding-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .brand { font: 700 1.1rem var(--mono); color: var(--text); text-decoration: none; }
  .brand span { color: var(--ok); }
  nav { display: flex; flex-wrap: wrap; gap: 1.25rem; font: 0.85rem var(--mono); }
  nav a { color: var(--dim); text-decoration: none; }
  nav a:hover, nav a[aria-current] { color: var(--text); }
  nav .lang { color: var(--ok); }
  main { padding-top: 2.5rem; padding-bottom: 4rem; }
  footer { padding-top: 1.5rem; padding-bottom: 3rem; border-top: 1px solid var(--line); color: var(--dim); font-size: 0.9rem; }
  a { color: var(--ok); }
  h1 { font-size: clamp(2rem, 6vw, 3.4rem); line-height: 1.08; margin: 0 0 1rem; letter-spacing: -0.02em; text-wrap: balance; }
  h2 { font-size: 1.5rem; line-height: 1.25; margin: 3rem 0 1rem; }
  h3 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  p { margin: 0 0 0.8rem; }
  .lede { color: var(--dim); font-size: 1.15rem; max-width: 42rem; }
  .mono, .tag, table, .evidence summary { font-family: var(--mono); font-size: 0.8rem; }
  .dim { color: var(--dim); }
  .tag { display: inline-block; padding: 0.1rem 0.5rem; border: 1px solid currentColor; border-radius: 99px; }
  .published { color: var(--ok); } .rejected, .error { color: var(--bad); } .empty { color: var(--warn); }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 1rem; }
  .stats b { display: block; font: 700 1.6rem var(--mono); }
  .stats span { color: var(--dim); font: 0.75rem var(--mono); }
  .evidence { margin-top: 0.6rem; }
  .evidence summary { cursor: pointer; color: var(--ok); }
  .evidence ul { list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .evidence li { padding: 0.8rem 0; border-top: 1px solid var(--line); font-size: 0.95rem; }
  blockquote { margin: 0.4rem 0; padding-left: 0.8rem; border-left: 2px solid var(--ok); color: var(--dim); font-style: italic; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--dim); font-weight: 400; }
  td.wrap { white-space: normal; min-width: 16rem; }
</style>
